{
  "permissions": {
    "allow": [
      "Bash(./gradlew build:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew :client-extensions:*)",
      "Bash(./gradlew deploy:*)",
      "Bash(blade server start:*)",
      "Bash(blade server stop:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(curl -s http://localhost:8080/o/*)",
      "Bash(curl -s http://localhost:58081/*)"
    ],
    "deny": [
      "Read(./**/*.env)",
      "Read(./**/application-secrets.properties)"
    ]
  }
}
